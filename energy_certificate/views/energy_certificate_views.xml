<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_energy_certificate_tree" model="ir.ui.view">
        <field name="name">energy.certificate.tree</field>
        <field name="model">energy.certificate</field>
        <field name="arch" type="xml">
            <tree string="Energy Certificates" decoration-danger="state=='expired'" decoration-warning="state=='expiring'" decoration-success="state=='valid'">
                <field name="name"/>
                <field name="property_name"/>
                <field name="property_type"/>
                <field name="energy_class" widget="badge"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="days_to_expiry"/>
                <field name="state" widget="badge" decoration-success="state=='valid'" decoration-warning="state=='expiring'" decoration-danger="state=='expired'" decoration-muted="state=='cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="view_energy_certificate_form" model="ir.ui.view">
        <field name="name">energy.certificate.form</field>
        <field name="model">energy.certificate</field>
        <field name="arch" type="xml">
            <form string="Energy Certificate">
                <header>
                    <button name="action_validate" string="Validate" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" confirm="Are you sure you want to cancel this certificate?" invisible="state in ['cancelled', 'expired']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,valid,expiring,expired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options="{'terminology': 'archive'}"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Certificate Number"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Property Information">
                            <field name="property_name"/>
                            <field name="property_address"/>
                            <field name="property_type"/>
                            <field name="building_area"/>
                        </group>
                        <group string="Certificate Details">
                            <field name="certificate_type"/>
                            <field name="energy_class" widget="badge"/>
                            <field name="energy_consumption"/>
                            <field name="co2_emissions"/>
                        </group>
                    </group>
                    <group>
                        <group string="Validity">
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="validity_period"/>
                            <field name="days_to_expiry" invisible="state in ['expired', 'cancelled']"/>
                        </group>
                        <group string="Inspector Information">
                            <field name="inspector_name"/>
                            <field name="inspector_license"/>
                            <field name="inspector_contact"/>
                            <field name="issuing_authority"/>
                        </group>
                    </group>
                    <group string="Additional Information">
                        <field name="notes" placeholder="Enter any additional notes or observations..."/>
                    </group>
                    <group string="Attachments">
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_energy_certificate_search" model="ir.ui.view">
        <field name="name">energy.certificate.search</field>
        <field name="model">energy.certificate</field>
        <field name="arch" type="xml">
            <search string="Search Energy Certificates">
                <field name="name" string="Certificate Number"/>
                <field name="property_name" string="Property"/>
                <field name="inspector_name" string="Inspector"/>
                <filter string="Valid" name="valid" domain="[('state', '=', 'valid')]"/>
                <filter string="Expiring Soon" name="expiring" domain="[('state', '=', 'expiring')]"/>
                <filter string="Expired" name="expired" domain="[('state', '=', 'expired')]"/>
                <separator/>
                <filter string="Residential" name="residential" domain="[('property_type', '=', 'residential')]"/>
                <filter string="Commercial" name="commercial" domain="[('property_type', '=', 'commercial')]"/>
                <separator/>
                <filter string="Class A+" name="class_a_plus" domain="[('energy_class', '=', 'a_plus')]"/>
                <filter string="Class A" name="class_a" domain="[('energy_class', '=', 'a')]"/>
                <filter string="Class B" name="class_b" domain="[('energy_class', '=', 'b')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Property Type" name="group_property_type" context="{'group_by': 'property_type'}"/>
                    <filter string="Energy Class" name="group_energy_class" context="{'group_by': 'energy_class'}"/>
                    <filter string="Issue Date" name="group_issue_date" context="{'group_by': 'issue_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_energy_certificate" model="ir.actions.act_window">
        <field name="name">Energy Certificates</field>
        <field name="res_model">energy.certificate</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Energy Certificate
            </p>
            <p>
                Track and manage energy efficiency certificates for properties.
            </p>
        </field>
    </record>
</odoo>
