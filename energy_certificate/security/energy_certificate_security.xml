<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_energy_certificate" model="ir.module.category">
        <field name="name">Energy Certificate</field>
        <field name="description">Manage energy certificates</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_energy_certificate_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_energy_certificate"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_energy_certificate_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_energy_certificate"/>
        <field name="implied_ids" eval="[(4, ref('group_energy_certificate_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="energy_certificate_rule_user" model="ir.rule">
        <field name="name">Energy Certificate: User access</field>
        <field name="model_id" ref="model_energy_certificate"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_energy_certificate_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="energy_certificate_rule_manager" model="ir.rule">
        <field name="name">Energy Certificate: Manager full access</field>
        <field name="model_id" ref="model_energy_certificate"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_energy_certificate_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
