<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="product_group_id" options="{'no_create': False, 'no_open': False}"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_tree_view_inherit" model="ir.ui.view">
        <field name="name">product.template.tree.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="product_group_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_search_view_inherit" model="ir.ui.view">
        <field name="name">product.template.search.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="product_group_id"/>
            </xpath>
            <xpath expr="//filter[@name='categ_id']" position="after">
                <filter string="Product Group" name="group_by_product_group" context="{'group_by': 'product_group_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_pivot_view_inherit" model="ir.ui.view">
        <field name="name">product.template.pivot.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_pivot_view"/>
        <field name="arch" type="xml">
            <xpath expr="//pivot" position="inside">
                <field name="product_group_id" type="row"/>
            </xpath>
        </field>
    </record>
</odoo>
