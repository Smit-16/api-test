<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="group_invoice_first_approver" model="res.groups">
            <field name="name">Invoice First Approver</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        </record>

        <record id="group_invoice_cfo_approver" model="res.groups">
            <field name="name">Invoice CFO Approver</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="implied_ids" eval="[(4, ref('group_invoice_first_approver'))]"/>
        </record>

        <record id="group_invoice_edit_approver" model="res.groups">
            <field name="name">Invoice Edit Request Approver</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_manager'))]"/>
        </record>

        <record id="invoice_approval_config_rule" model="ir.rule">
            <field name="name">Invoice Approval Config: Multi-Company</field>
            <field name="model_id" ref="model_invoice_approval_config"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="invoice_edit_request_rule" model="ir.rule">
            <field name="name">Invoice Edit Request: Multi-Company</field>
            <field name="model_id" ref="model_invoice_edit_request"/>
            <field name="domain_force">['|', ('invoice_id.company_id', '=', False), ('invoice_id.company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
