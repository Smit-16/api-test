<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_invoice_approval_config_form" model="ir.ui.view">
            <field name="name">invoice.approval.config.form</field>
            <field name="model">invoice.approval.config</field>
            <field name="arch" type="xml">
                <form string="Invoice Approval Configuration">
                    <sheet>
                        <group>
                            <group>
                                <field name="company_id" options="{'no_create': True}"/>
                                <field name="approval_enabled"/>
                                <field name="auto_post_after_approval"/>
                            </group>
                            <group>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="First Level Approval">
                                <group>
                                    <field name="first_approver_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}"/>
                                </group>
                            </page>
                            <page string="CFO Approval">
                                <group>
                                    <field name="cfo_approval_threshold" widget="monetary"/>
                                    <field name="cfo_approver_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}"/>
                                </group>
                            </page>
                            <page string="Edit Request Approval">
                                <group>
                                    <field name="edit_request_approver_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_invoice_approval_config_tree" model="ir.ui.view">
            <field name="name">invoice.approval.config.tree</field>
            <field name="model">invoice.approval.config</field>
            <field name="arch" type="xml">
                <tree string="Invoice Approval Configuration">
                    <field name="company_id"/>
                    <field name="approval_enabled" widget="boolean_toggle"/>
                    <field name="cfo_approval_threshold" widget="monetary"/>
                    <field name="auto_post_after_approval" widget="boolean_toggle"/>
                </tree>
            </field>
        </record>

        <record id="action_invoice_approval_config" model="ir.actions.act_window">
            <field name="name">Invoice Approval Configuration</field>
            <field name="res_model">invoice.approval.config</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first invoice approval configuration
                </p>
            </field>
        </record>

    </data>
</odoo>
