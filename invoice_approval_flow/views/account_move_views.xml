<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_move_form_inherit_approval" model="ir.ui.view">
            <field name="name">account.move.form.inherit.approval</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                
                <xpath expr="//header" position="inside">
                    <field name="approval_state" widget="statusbar" statusbar_visible="draft,first_approved,pending_cfo,fully_approved" invisible="not approval_required"/>
                    <button name="action_first_approve" string="First Approval" type="object" class="oe_highlight" invisible="not can_first_approve" groups="invoice_approval_flow.group_invoice_first_approver"/>
                    <button name="action_cfo_approve" string="CFO Approval" type="object" class="oe_highlight" invisible="not can_cfo_approve" groups="invoice_approval_flow.group_invoice_cfo_approver"/>
                    <button name="action_request_edit" string="Request Edit" type="object" invisible="not can_request_edit"/>
                </xpath>

                <xpath expr="//sheet" position="before">
                    <div class="alert alert-warning" role="alert" invisible="not is_locked">
                        <strong>Invoice Locked:</strong> This invoice is locked for editing. Submit an edit request to modify.
                    </div>
                    <div class="alert alert-info" role="alert" invisible="not pending_edit_request">
                        <strong>Pending Edit Request:</strong> An edit request is pending approval for this invoice.
                    </div>
                </xpath>

                <xpath expr="//notebook" position="inside">
                    <page string="Approval Details" invisible="not approval_required">
                        <group>
                            <group string="First Level Approval">
                                <field name="first_approver_id" readonly="1"/>
                                <field name="first_approval_date" readonly="1"/>
                            </group>
                            <group string="CFO Approval" invisible="not cfo_approval_required">
                                <field name="cfo_approver_id" readonly="1"/>
                                <field name="cfo_approval_date" readonly="1"/>
                                <field name="cfo_approval_required" invisible="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="approval_required" invisible="1"/>
                            <field name="can_first_approve" invisible="1"/>
                            <field name="can_cfo_approve" invisible="1"/>
                            <field name="can_request_edit" invisible="1"/>
                            <field name="is_locked" invisible="1"/>
                        </group>
                        <group string="Edit Requests">
                            <field name="edit_request_ids" nolabel="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="requester_id"/>
                                    <field name="request_date"/>
                                    <field name="state" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'" widget="badge"/>
                                </tree>
                            </field>
                        </group>
                    </page>
                </xpath>

            </field>
        </record>

        <record id="view_account_move_filter_inherit_approval" model="ir.ui.view">
            <field name="name">account.move.filter.inherit.approval</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_invoice_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='draft']" position="after">
                    <separator/>
                    <filter string="Pending First Approval" name="pending_first" domain="[('approval_state', '=', 'draft'), ('approval_required', '=', True), ('move_type', 'in', ['in_invoice', 'in_refund'])]"/>
                    <filter string="Pending CFO Approval" name="pending_cfo" domain="[('approval_state', '=', 'pending_cfo')]"/>
                    <filter string="Fully Approved" name="fully_approved" domain="[('approval_state', '=', 'fully_approved')]"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
