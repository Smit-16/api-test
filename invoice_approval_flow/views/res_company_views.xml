<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_company_form_inherit_approval" model="ir.ui.view">
            <field name="name">res.company.form.inherit.approval</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Invoice Approval">
                        <group>
                            <field name="invoice_approval_enabled"/>
                        </group>
                        <div class="alert alert-info" role="alert">
                            <p>Configure detailed approval settings in <strong>Accounting → Configuration → Invoice Approval Configuration</strong></p>
                        </div>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
